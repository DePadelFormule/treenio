# Supabase — vind deze in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NOOIT met NEXT_PUBLIC_ prefix exposen. Alleen voor admin-taken / seeds.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI-lesgenerator — Anthropic (Claude). Server-only, NOOIT met NEXT_PUBLIC_.
# Maak een sleutel aan op console.anthropic.com (met een klein tegoed).
ANTHROPIC_API_KEY=

# Resend (later, voor mails)
RESEND_API_KEY=
RESEND_FROM="Treenio <coach@jouwdomein.nl>"

# Basis-URL van de app (voor redirects/mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# KNVB Dataservice (voetbal.nl) — alleen voor het wedstrijdprogramma.
# De club krijgt deze endpoint-URL (incl. pad/key) via een Club.Dataservice-
# abonnement. Laat leeg tot je de gegevens hebt; de import-knop meldt dan netjes
# dat de koppeling nog niet is ingesteld.
KNVB_PROGRAMMA_URL=
# Optioneel: code/naam van jullie elftal om de tegenstander correct te bepalen.
KNVB_TEAM_CODE=
